**/.ipynb_checkpoints/
**/__pycache__/
*.pyc

# Logs
*.log
logs/

# Ambiente virtual Python
venv/
env/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Credenciais (se houver)
.env
*.key
*.pem
credentials/